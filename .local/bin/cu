#!/usr/bin/env bash
# cu ["message"]: sync dotfiles, then ~/Documents/sync (one-commit repo, force-pushed)

config() { git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"; }

dotfiles() {
    echo "==> Dotfiles"
    config add -u || return
    if ! config diff --cached --quiet; then
        config commit -q -m "${1:-update: $(config diff --cached --name-only | sed 's|.*/||' | sort -u | head -6 | paste -sd ' ' -)}" || return
    fi
    { config pull --rebase origin main || locks; } && config push origin main
}

# Both machines ran rb -u: keep each input's newer lock. Anything else stays stopped for you.
locks() {
    local f files
    [ -d "$HOME/.dotfiles/rebase-merge" ] || return 1
    while [ -d "$HOME/.dotfiles/rebase-merge" ]; do
        files=$(config diff --name-only --diff-filter=U)
        [ -n "$files" ] && ! grep -qv 'flake\.lock$' <<<"$files" || return 1
        while read -r f; do
            jq -S -s '.[0] as $o | .[1] as $t | $o | .nodes = ($t.nodes + $o.nodes)
                | .nodes |= with_entries(if ($t.nodes[.key].locked.lastModified // 0) >
                    (.value.locked.lastModified // 0) then .value = $t.nodes[.key] else . end)' \
                <(config show ":2:$f") <(config show ":3:$f") >"$HOME/$f.cu" &&
                mv "$HOME/$f.cu" "$HOME/$f" && config add "$HOME/$f" || return 1
            echo "cu: kept the newer inputs in $f"
        done <<<"$files"
        if config diff --cached --quiet; then
            config rebase --skip
        else
            GIT_EDITOR=true config rebase --continue
        fi
    done
}

documents() {
    local d=~/Documents/sync mine='' theirs='' old base
    echo "==> ~/Documents/sync"
    [ -d "$d/.git" ] || git clone https://github.com/Bueezi/sync "$d" || return
    # --depth=1: else the server resends every file, as each sync is a new root commit
    git -C "$d" fetch --progress --depth=1 origin || return
    old=$(git -C "$d" rev-parse origin/main)
    # Not HEAD: after a failed push it looked like another machine's change and wiped local files
    git -C "$d" rev-parse -q --verify refs/sync/base >/dev/null || git -C "$d" update-ref refs/sync/base HEAD
    base=$(git -C "$d" rev-parse refs/sync/base)
    git -C "$d" add -A
    git -C "$d" diff --cached --quiet "$base" || mine=1
    [ "$base" = "$old" ] || theirs=1
    if [ -n "$mine" ] && [ -n "$theirs" ]; then
        echo "cu: ~/Documents/sync changed here and on another machine since the last sync; sort it out by hand" >&2
        return 1
    elif [ -n "$theirs" ]; then
        git -C "$d" reset -q --hard origin/main && git -C "$d" update-ref refs/sync/base "$old" &&
            echo "cu: took the other machines' ~/Documents/sync"
    elif [ -n "$mine" ]; then
        git -C "$d" reset -q --soft "$(git -C "$d" commit-tree "$(git -C "$d" write-tree)" -m sync)" &&
            # Else every push resends all files (~100 MB)
            git -C "$d" repack -q -a -d --write-bitmap-index &&
            git -C "$d" push -q --force-with-lease=main:"$old" origin HEAD:main &&
            git -C "$d" update-ref refs/sync/base HEAD && echo "cu: pushed ~/Documents/sync"
    else
        git -C "$d" update-ref refs/sync/base "$old"
    fi
}

ok=0
dotfiles "$1" || ok=1
documents || ok=1
exit $ok
