#!/usr/bin/env bash
# cu ["message"]: sync this machine with the others.
# 1. Dotfiles (bare repo ~/.dotfiles, work tree ~): commit tracked changes, pull --rebase, push. New
#    files still need an explicit `config add <file>` first. Without a message, the commit lists the
#    changed files' names.
# 2. ~/Documents/sync (wallpapers in wp/): its own private repo, github.com/Bueezi/sync, that only
#    ever has one commit, so a file deleted here is gone from GitHub too. Takes the other machines'
#    state, or replaces the commit with this folder and force-pushes; stops if both sides changed.

config() { git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"; }

dotfiles() {
    echo "==> Dotfiles"
    config add -u || return
    if ! config diff --cached --quiet; then
        config commit -q -m "${1:-update: $(config diff --cached --name-only | sed 's|.*/||' | sort -u | head -6 | paste -sd ' ' -)}" || return
    fi
    # origin main spelled out: a fresh clone (the tablet's) has no upstream branch set
    config pull --rebase origin main && config push origin main
}

documents() {
    local d=~/Documents/sync mine= theirs= old
    echo "==> ~/Documents/sync"
    # Not quiet: the first clone (the wallpapers) takes a while, git shows its progress
    [ -d "$d/.git" ] || git clone https://github.com/Bueezi/sync "$d" || return
    git -C "$d" fetch --progress origin || return
    git -C "$d" add -A
    git -C "$d" diff --cached --quiet HEAD || mine=1
    old=$(git -C "$d" rev-parse origin/main)
    [ "$(git -C "$d" rev-parse HEAD)" = "$old" ] || theirs=1
    if [ -n "$mine" ] && [ -n "$theirs" ]; then
        echo "cu: ~/Documents/sync changed here and on another machine since the last sync; sort it out by hand" >&2
        return 1
    elif [ -n "$theirs" ]; then
        git -C "$d" reset -q --hard origin/main && echo "cu: took the other machines' ~/Documents/sync"
    elif [ -n "$mine" ]; then
        git -C "$d" reset -q --soft "$(git -C "$d" commit-tree "$(git -C "$d" write-tree)" -m sync)" &&
            git -C "$d" push -q --force-with-lease=main:"$old" origin HEAD:main && echo "cu: pushed ~/Documents/sync"
    fi
}

ok=0
dotfiles "$1" || ok=1
documents || ok=1
exit $ok
