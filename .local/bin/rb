#!/bin/sh
# rb: rebuild this machine from its config. NixOS: nixos-rebuild switch; the tablet: termux.sh.
# rb -u (or --upgrade): update too (NixOS: the channel first, so newer packages)
if [ -n "$TERMUX_VERSION" ]; then exec "$HOME/.config/scripts/termux.sh" "$@"; fi
[ "$1" = -u ] && { shift; set -- --upgrade "$@"; }
old=$(readlink /run/current-system)
# --no-reexec: not first building nixos-rebuild itself from the new config (a second evaluation)
sudo nixos-rebuild switch --no-reexec "$@" || exit
# What changed: packages added, removed, updated (nothing to show when the system stayed the same)
if [ "$old" != "$(readlink /run/current-system)" ] && command -v nvd >/dev/null; then
    nvd diff "$old" /run/current-system
fi
# VSCodium's extensions (~/.config/VSCodium/extensions, shared with the tablet): the missing ones
have=$(codium --list-extensions 2>/dev/null | tr 'A-Z' 'a-z')
grep -v '^\s*\(#\|$\)' "$HOME/.config/VSCodium/extensions" | while read -r e; do
    echo "$have" | grep -qx "$e" || codium --install-extension "$e" >/dev/null 2>&1 || echo "rb: no $e"
done
# Lean 4: a default toolchain once (elan has none at first; projects pick theirs in lean-toolchain)
if command -v elan >/dev/null && elan toolchain list | grep -q '^no installed'; then
    elan toolchain install stable && elan default stable
fi
# Flatpak apps (~/.config/flatpak/apps): the missing ones, per user (no root needed)
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
have=$(flatpak list --user --app --columns=application 2>/dev/null)
sed 's/#.*//' "$HOME/.config/flatpak/apps" | while read -r a; do
    [ -n "$a" ] || continue
    echo "$have" | grep -qx "$a" || flatpak install --user -y --noninteractive flathub "$a" || echo "rb: no $a"
done
