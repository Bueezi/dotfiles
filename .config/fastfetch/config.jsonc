{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos_small",
    "color": { "1": "white", "2": "white" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "bright_black", "title": "white" },
    "key": { "width": 6 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kern" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "packages", "key": "pkgs" },
    { "type": "uptime",   "key": "up" },
    "break",
    { "type": "cpu",      "key": "cpu" },
    { "type": "gpu",      "key": "gpu" },
    { "type": "display",  "key": "disp", "format": "{width}x{height}" },
    { "type": "memory",   "key": "mem" },
    { "type": "disk",     "key": "disk" }
  ]
}
