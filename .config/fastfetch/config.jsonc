{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "right": 3 }
  },
  "display": {
    "separator": ": ",
    "color": { "keys": "bold_bright_white", "title": "bold_bright_white", "separator": "bright_white", "output": "38;5;248" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "OS" },
    { "type": "command",  "key": "Kernel", "text": "uname -sr | sed 's/-android.*//'" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "wm",       "key": "WM" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "Memory", "format": "{used} / {total}" }
  ]
}
