# Plymouth script theme: loop the frames (frame-001.png ...) in the centre of a black screen.
# @frames@, @fps@ and @hold@ are filled in at build time by ../plymouth.nix.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

frame_count = @frames@;
fps = @fps@;
hold = @hold@;   # seconds on the first frame once a display is up (monitor sync)

for (i = 0; i < frame_count; i = i + 1) {
    n = i + 1;
    if (n < 10) {
        name = "frame-00" + n + ".png";
    } else if (n < 100) {
        name = "frame-0" + n + ".png";
    } else {
        name = "frame-" + n + ".png";
    }
    frames[i] = Image(name);
}

sprite = Sprite(frames[0]);

# Plymouth calls this 50 times a second. Variables set inside a function are local unless
# prefixed with global. The clip only starts once there is a display (the GPU driver can come
# up seconds after plymouth), then holds the first frame while the monitor syncs.
tick = 0;
fun refresh_callback() {
    if (Window.GetWidth() > 0) {
        sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - frames[0].GetWidth() / 2);
        sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - frames[0].GetHeight() / 2);

        global.tick = global.tick + 1;
        f = Math.Int((global.tick - hold * 50) * fps / 50);
        if (f < 0) {
            f = 0;
        }
        f = f - Math.Int(f / frame_count) * frame_count;   # loop
        sprite.SetImage(frames[f]);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);
