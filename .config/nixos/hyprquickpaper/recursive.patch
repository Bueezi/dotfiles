+    Connections {
+        target: configs
+        function onWallpaper_pathChanged() { Qt.callLater(() => findFiles.running = true) }
+    }
+
+    Process {
+        id: findFiles
+        command: ["find", "-L", configs.wallpaper_path.replace("~", Quickshell.env("HOME")), "-type", "f",
+            "(", "-iname", "*.png", "-o", "-iname", "*.jpg", "-o", "-iname", "*.jpeg", ")"]
+        stdout: StdioCollector {
+            id: foundFiles
+            onStreamFinished: {
+                const files = foundFiles.text.split("\n").filter(l => l.length > 0).sort()
+                folderModel.clear()
+                for (const f of files)
+                    folderModel.append({ filePath: f, fileName: f.substring(f.lastIndexOf("/") + 1) })
+            }
+        }
