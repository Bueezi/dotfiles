# ── Variables ───────────────────────────────────────
set $mod     Mod4
set $left    h
set $down    j
set $up      k
set $right   l
set $term    foot
set $fm      thunar
set $menu    fuzzel
set $browser librewolf
set $discord vesktop
set $scripts ~/.config/sway/scripts

set $bg      #000000
set $fg      #ffffff
set $dim     #777777
set $subtle  #333333

# ── Appearance ──────────────────────────────────────
font pango:JetBrainsMono Nerd Font 10

# class                 border   bg    text  indicator child_border
client.focused          $fg      $bg   $fg   $fg       $fg
client.focused_inactive $subtle  $bg   $dim  $subtle   $subtle
client.unfocused        $subtle  $bg   $dim  $subtle   $subtle
client.urgent           $fg      $fg   $bg   $fg       $fg

default_border          pixel 2
default_floating_border pixel 2
smart_borders on
gaps inner 5
smart_gaps on

# SwayFX (rounded corners need gaps to be visible)
corner_radius 6
# shadows enable
blur enable
blur_xray disable
blur_passes 3
blur_radius 4

# cursor
seat * xcursor_theme Adwaita 24

# ── Outputs ─────────────────────────────────────────
# Output names: swaymsg -t get_outputs
output * bg ~/.local/state/wallpaper fill

output eDP-1 {
    scale 1.35
    render_bit_depth 10
}
output DP-2 {
    mode 2560x1440@180.000Hz
    allow_tearing yes
    render_bit_depth 10
}

# ── Inputs ──────────────────────────────────────────
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    scroll_factor 0.65
}
input "14139:4229:CX_Wireless_mouse_-1k_dongle_Mouse" {
    accel_profile flat
    pointer_accel 0
}

# ── Autostart ───────────────────────────────────────
exec mako
exec lxqt-policykit-agent
exec wlsunset -l 50.8 -L 4.7
exec $scripts/battery-notify.sh
exec sh -c 'rm -f ~/.cache/cliphist/db && exec wl-paste --watch $scripts/clipstore.sh'
# Laptop only: start muted
exec sh -c 'test -d /sys/class/power_supply/BAT0 && sleep 2 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 0'

# Idle (swayidle) lives in a script so caffeine.sh can stop/restart it
exec $scripts/idle.sh

# Window switcher daemon (Alt+Tab)
exec swayrd

# ── Window rules ────────────────────────────────────
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"]  inhibit_idle fullscreen

for_window [app_id="^(floating|Thunar|thunar|blueman-manager|org.gnome.FileRoller|org.gnome.eog|xdg-desktop-portal-gtk)$"] floating enable, resize set 900 600, move position center
# for_window [class="Spotify"] floating enable, resize set 900 600, move position center
for_window [app_id="^clipboard$"] floating enable, resize set 760 420, move position center

# $mod + left drag = move, $mod + right drag = resize
floating_modifier $mod normal
focus_on_window_activation focus

# ── Keybindings ─────────────────────────────────────
bindsym {
    # Apps
    $mod+Return         exec $term
    $mod+Shift+Return   exec $term --app-id=floating
    $mod+d              exec $menu
    $mod+Shift+e        exec $fm
    $mod+Shift+v        exec $scripts/clipboard.sh
    $mod+Shift+s        exec sh -c 'g=$(slurp) && grim -g "$g" - | wl-copy && notify-send "Screenshot in clipboard"'
    $mod+Shift+n        exec networkmanager_dmenu
    $mod+grave          exec swaymsg '[app_id="librewolf"] focus' || $browser
    $mod+Shift+d        exec swaymsg '[app_id="vesktop"] focus' || $discord
    $mod+t              exec swaymsg '[app_id="foot"] focus' || $term
    $mod+Shift+b        exec $scripts/bluetooth.sh

    # Scripts
    $mod+Shift+a        exec $scripts/audio_switch.sh
    $mod+Shift+p        exec $scripts/power.sh
    $mod+p              exec $scripts/display.sh
    $mod+Shift+t        exec $scripts/theme.sh
    $mod+Shift+x        exec $scripts/hdr.sh
    $mod+Shift+r        exec $scripts/record.sh
    $mod+Shift+w        exec $scripts/wallpaper.sh
    $mod+Shift+i        exec $scripts/caffeine.sh
    $mod+slash          exec $scripts/keybinds.sh

    # Session
    $mod+q              kill
    $mod+Escape         exec swaylock
    Print               exec systemctl sleep
    $mod+Shift+c        reload
    $mod+Shift+m        exec swaynag -t warning -m 'Exit SwayFX? This will end your Wayland session.' -B 'Yes, exit' 'swaymsg exit'

    # Focus
    $mod+$left          focus left
    $mod+$down          focus down
    $mod+$up            focus up
    $mod+$right         focus right
    $mod+Left           focus left
    $mod+Down           focus down
    $mod+Up             focus up
    $mod+Right          focus right
    # Alt+Tab: hold Alt, tap Tab to step back through recent windows
    Mod1+Tab            exec swayr next-window all-workspaces
    Mod1+Shift+Tab      exec swayr prev-window all-workspaces

    # Move window
    $mod+Shift+$left    move left
    $mod+Shift+$down    move down
    $mod+Shift+$up      move up
    $mod+Shift+$right   move right
    $mod+Shift+Left     move left
    $mod+Shift+Down     move down
    $mod+Shift+Up       move up
    $mod+Shift+Right    move right

    # Workspaces
    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9
    $mod+0 workspace number 10

    $mod+Shift+1 move container to workspace number 1
    $mod+Shift+2 move container to workspace number 2
    $mod+Shift+3 move container to workspace number 3
    $mod+Shift+4 move container to workspace number 4
    $mod+Shift+5 move container to workspace number 5
    $mod+Shift+6 move container to workspace number 6
    $mod+Shift+7 move container to workspace number 7
    $mod+Shift+8 move container to workspace number 8
    $mod+Shift+9 move container to workspace number 9
    $mod+Shift+0 move container to workspace number 10

    # Layout
    $mod+v              splith
    $mod+c              splitv
    $mod+s              layout stacking
    $mod+w              layout tabbed
    $mod+e              layout toggle split
    $mod+f              fullscreen
    $mod+Shift+space    floating toggle
    $mod+space          focus mode_toggle
    $mod+a              focus parent

    # Scratchpad
    $mod+Shift+minus    move scratchpad
    $mod+minus          scratchpad show

    $mod+r              mode "resize"
}

# Media & brightness keys (work on the lock screen too)
bindsym --locked {
    XF86AudioMute          exec $scripts/osd.sh volume mute
    XF86AudioLowerVolume   exec $scripts/osd.sh volume down
    XF86AudioRaiseVolume   exec $scripts/osd.sh volume up
    XF86AudioMicMute       exec $scripts/osd.sh mic mute
    XF86AudioPlay          exec $scripts/osd.sh media play
    XF86AudioNext          exec $scripts/osd.sh media next
    XF86AudioPrev          exec $scripts/osd.sh media prev
    XF86MonBrightnessDown  exec $scripts/osd.sh brightness down
    XF86MonBrightnessUp    exec $scripts/osd.sh brightness up
}

mode "resize" {
    bindsym $left   resize shrink width 10px
    bindsym $down   resize grow height 10px
    bindsym $up     resize shrink height 10px
    bindsym $right  resize grow width 10px
    bindsym Left    resize shrink width 10px
    bindsym Down    resize grow height 10px
    bindsym Up      resize shrink height 10px
    bindsym Right   resize grow width 10px
    bindsym Return  mode "default"
    bindsym Escape  mode "default"
}

# ── Bar ─────────────────────────────────────────────
bar {
    position top
    height 20
    workspace_min_width 30
    status_command i3status-rs ~/.config/sway/i3status.toml
    font pango:JetBrainsMono Nerd Font 9
    tray_output *

    colors {
        background         $bg
        statusline         $fg
        separator          $subtle
        focused_workspace  $fg $fg $bg
        active_workspace   $bg $bg $fg
        inactive_workspace $bg $bg $dim
        urgent_workspace   $fg #555555 $fg
    }
}

include /etc/sway/config.d/*
