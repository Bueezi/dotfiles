# swaylock-effects: blurred snapshot of the desktop fading in, clock inside the ring.
# (The fade used to start ~1s late; patched in .configuration.nix, see swaylockFx)
screenshots
effect-blur=9x5
effect-vignette=0.4:0.9
fade-in=0.5
clock
indicator
timestr=%H:%M
datestr=%a %d/%m

color=000000
font=JetBrainsMono Nerd Font
indicator-radius=110
indicator-thickness=6
inside-color=00000088
inside-clear-color=00000088
inside-ver-color=00000088
inside-wrong-color=00000088
ring-color=ffffff
ring-clear-color=ffffff
ring-ver-color=aaaaaa
ring-wrong-color=555555
key-hl-color=888888
bs-hl-color=444444
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
text-color=ffffff
text-clear-color=ffffff
text-ver-color=ffffff
text-wrong-color=ffffff
