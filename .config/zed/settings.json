// Zed (`zeditor`, dev.nix). Only what differs from its defaults: `zed: open default settings`
{
  "disable_ai": true,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "helix_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 18,
  "buffer_font_size": 17,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
}
