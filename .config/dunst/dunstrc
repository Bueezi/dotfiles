# dunst on the tablet: mako's counterpart (~/.config/mako/config), same black and white look
# (see-through like mako, without the blur: xcompmgr, see wm/i3).
[global]
    font = JetBrainsMono Nerd Font 10
    origin = top-right
    # Below i3bar (i3 keeps no room for it, unlike sway's layers for mako): its 34 px at 192 dpi
    # are 17 here, dunst's sizes grow with Xft.dpi too. Change it with the bar's font
    offset = (10, 27)
    width = 300
    gap_size = 10
    padding = 10
    horizontal_padding = 10
    frame_width = 2
    frame_color = "#ffffff"
    corner_radius = 6
    icon_position = left
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

# Low (the OSD-style ones): grey, like mako's
[urgency_low]
    background = "#000000b3"
    foreground = "#aaaaaa"
    frame_color = "#555555"
    timeout = 4

[urgency_normal]
    background = "#000000b3"
    foreground = "#ffffff"
    frame_color = "#ffffff"
    timeout = 4

# Critical: inverted, stays until clicked
[urgency_critical]
    background = "#ffffff"
    foreground = "#000000"
    frame_color = "#ffffff"
    timeout = 0
