#!/data/data/com.termux/files/usr/bin/bash
# `desktop`: the tablet's desktop. Termux:X11 (the X server, shown by its Android app) with i3 in
# it (~/.config/wm/i3), inside a D-Bus session (dunst, dconf and notify-send need one).
# Usage: desktop        start it in the background (the terminal stays free; log in
#                       $PREFIX/tmp/desktop.log), or just show it if it's already running
#        desktop hide   back to Android's home screen; the desktop keeps running
#        desktop stop   close the desktop; Termux keeps running
#        desktop exit   close the desktop and exit Termux too
# The power menu and the Termux:Widget buttons Start/Stop (made by termux.sh) run the same.
# GPU: native apps use Zink on Turnip (Adreno's open Vulkan driver), the proot container (`debian`) uses
# VirGL. If `glxinfo -B` shows llvmpipe, Zink isn't working: GALLIUM_DRIVER=virpipe instead.

# Size of everything (fonts, bar, apps): X11's DPI, which i3, alacritty, rofi, dunst and Qt read
# (xrdb below) and GTK through xsettingsd (darkmode.sh). 96 = 100 %, 144 = 150 %, 192 = 200 %
export XFT_DPI=168

# Termux:Widget runs this without a terminal's environment: the PATH a shell would have
# (i3status-rs is in ~/.cargo/bin, cliphist in ~/.local/bin), and no termux-exec, which makes
# scripts' `#!/usr/bin/env bash` work (Android has no /usr/bin/env: "wallpaper.sh: not found")
export PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PATH="$HOME/.config/termux/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PREFIX/bin:$PATH"
export LANG="${LANG:-en_US.UTF-8}"
if [ -z "$LD_PRELOAD" ]; then
    for l in libtermux-exec-ld-preload.so libtermux-exec.so; do
        [ -f "$PREFIX/lib/$l" ] && { export LD_PRELOAD="$PREFIX/lib/$l"; break; }
    done
fi

# Termux's own am (the running Termux app does the work, over a socket): Android's starts a Java VM
# every time, about a second for each Start/hide. Android's if Termux's isn't there or fails
am() { termux-am "$@" 2>/dev/null || command am "$@"; }

log="$PREFIX/tmp/desktop.log"
show() { am start -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1; }
home() { am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1; }
# Running = the X server answers (its process name isn't reliable: Start restarted a running desktop)
running() { DISPLAY=:0 timeout 2 xrdb -query >/dev/null 2>&1; }
stop() {
    pkill -f termux.x11; pkill -f virgl_test_server; pkill -f 'wallpaper\.sh loop( later)?$'
    pkill -f 'sleep 60; exec xcompmg[r]'   # a compositor still waiting to start (below)
    for _ in $(seq 50); do running || break; sleep 0.1; done
    # A leftover socket made the next start look ready too early: i3 found no X (black screen)
    rm -f "$PREFIX/tmp/.X11-unix/X0" "$PREFIX/tmp/.X0-lock"
}

case "$1" in
hide)   home; exit ;;
stop)   stop; exit ;;
# exit: Termux:X11 out of sight first (Android's home screen), then everything closes
exit)   home; stop; am startservice -a com.termux.service_stop com.termux/.app.TermuxService >/dev/null 2>&1; exit ;;
"")     if running; then show; exit; fi
        setsid -f "$0" --here > "$log" 2>&1 < /dev/null
        echo "Desktop starting (log: $log)"
        exit ;;
--here) ;;
*)      echo "usage: desktop [hide|stop|exit]" >&2; exit 1 ;;
esac

stop

# Audio; proot apps reach it over TCP
pulseaudio --check 2>/dev/null || pulseaudio --start --exit-idle-time=-1 \
    --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1"

virgl_test_server_android >/dev/null 2>&1 &
termux-x11 :0 >/dev/null 2>&1 &
export DISPLAY=:0
# Ready = the X server answers (not just its socket file existing)
for _ in $(seq 100); do xrdb -query >/dev/null 2>&1 && break; sleep 0.1; done
show

export GALLIUM_DRIVER=zink MESA_LOADER_DRIVER_OVERRIDE=zink TU_DEBUG=noconform
# Frames to Termux:X11 by copy, not DRI3: Mesa 26's DRI3 path leaves stale bits of old frames on
# screen (letters appearing and disappearing in alacritty). Apps still render on the GPU
export MESA_VK_WSI_DEBUG=sw
# The cursor grows with it (20 px at 96 dpi, like the desktop): for X11 apps, as X resources too
# (some only read those), and GTK's through xsettingsd (darkmode.sh)
export XCURSOR_THEME=Bibata-Modern-Classic XCURSOR_SIZE=$(( 20 * XFT_DPI / 96 ))
printf 'Xft.dpi: %s\nXcursor.theme: %s\nXcursor.size: %s\n' "$XFT_DPI" "$XCURSOR_THEME" "$XCURSOR_SIZE" | xrdb -merge
# Compositor (transparency): xcompmgr, a minute in and outside i3. Started by i3, at login or 20s
# later, it froze the screen (asleep, waiting on X; killing it unfroze); started a minute in from
# outside i3 it didn't. Which of the two matters isn't known. Windows are opaque until then
setsid -f sh -c 'sleep 60; exec xcompmgr' >/dev/null 2>&1 < /dev/null
exec dbus-run-session -- i3
