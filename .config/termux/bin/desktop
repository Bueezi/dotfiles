#!/data/data/com.termux/files/usr/bin/bash
# Starts the tablet's desktop: Termux:X11 (the X server, shown by its Android app), then i3 in it
# (~/.config/wm/i3), inside a D-Bus session (dunst, dconf and notify-send need one).
# GPU: native apps use Zink on Turnip (Adreno's open Vulkan driver), the proot container (pd) uses
# VirGL. If `glxinfo -B` shows llvmpipe, Zink isn't working: GALLIUM_DRIVER=virpipe instead.

# A previous session's X server and VirGL (i3 ends with its X server)
pkill -f termux.x11; pkill -f virgl_test_server

# Audio; proot apps reach it over TCP
pulseaudio --check 2>/dev/null || pulseaudio --start --exit-idle-time=-1 \
    --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1"

virgl_test_server_android >/dev/null 2>&1 &
termux-x11 :0 >/dev/null 2>&1 &
# Wait for the X socket instead of a fixed sleep
for _ in $(seq 50); do [ -S "$PREFIX/tmp/.X11-unix/X0" ] && break; sleep 0.1; done
am start -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1

export DISPLAY=:0
export GALLIUM_DRIVER=zink MESA_LOADER_DRIVER_OVERRIDE=zink TU_DEBUG=noconform
export XCURSOR_THEME=Bibata-Modern-Classic XCURSOR_SIZE=20
exec dbus-run-session -- i3
