# i3 on the tablet (Termux:X11). The looks and window keys shared with sway are in
# ~/.config/wm/common.conf. ~/.config/i3/config is a symlink to this file; `desktop` (~/.config/termux/bin)
# starts it. i3 can't use variables set in common.conf here, so the bar's colours are spelled out.

# ── Variables ───────────────────────────────────────
# Super, like the desktop: on the keyboard case the option key where a PC's Win key sits (keymap
# below). Some combos still need Termux:X11's "capture system shortcuts" (else Android takes them)
set $mod        Mod4
set $term       alacritty
set $term_float alacritty --class scratch-float
set $fm         thunar
set $menu       rofi -show drun
set $browser    librewolf
set $scripts    ~/.config/wm/scripts

include ~/.config/wm/common.conf

# ── Autostart ───────────────────────────────────────
# The keyboard case like a PC's (~/.config/termux/keymap.xkb): option = Super, cmd = Alt, top left
# = Esc (Shift: ~), Caps Lock = ` (Shift: Caps Lock)
exec --no-startup-id xkbcomp -w0 ~/.config/termux/keymap.xkb $DISPLAY
# Dark/light first: writes alacritty's colours and qt6ct's file, starts xsettingsd (GTK on X11)
exec --no-startup-id $scripts/darkmode.sh apply
exec --no-startup-id dunst
# Compositor: xcompmgr, transparency only (the see-through bar, rofi, dunst and alacritty; no blur).
# picom made the whole desktop slower, even without blur. The screen that "froze" with xcompmgr was
# Honor's battery manager freezing Termux 15-30 s after a start from the widget, not xcompmgr
exec --no-startup-id xcompmgr
exec --no-startup-id $scripts/clipstore.sh
exec --no-startup-id $scripts/wallpaper.sh restore
# An empty slot at the tray's far end, the bar's gap on the right: i3bar's padding doesn't move the
# tray out of the round corner (tray-spacer.c in ~/.config/termux, built by termux.sh)
exec --no-startup-id tray-spacer 1

# ── Window rules (X11: by class) ────────────────────
# Sizes as a share of the screen: fixed pixels look tiny at the tablet's DPI
for_window [class="^clipboard$"] floating enable, resize set 50 ppt 50 ppt, move position center
# Scratchpad apps ($mod+Shift+Return / e, the power menu's terminal): floating in the scratchpad,
# shown. The same key (or $mod+minus) hides/shows them again
for_window [class="^(scratch-.*|Thunar)$"] floating enable, resize set 60 ppt 70 ppt, move scratchpad, scratchpad show, move position center
# Eclipse Music (Electron, ~/.config/nixos/webapps): floating like on sway
for_window [class="(?i)^eclipse$"] floating enable, resize set 60 ppt 70 ppt, move position center
# Marked for scripts/open.sh ($mod+Shift+d), like on sway
for_window [class="(?i)^vesktop$"] mark --add vesktop, floating enable, resize set 60 ppt 70 ppt, move position center
for_window [window_role="pop-up"] floating enable
# GTK's file chooser (LibreWolf's save dialog…): it sized itself to the whole screen at this DPI
for_window [window_role="GtkFileChooserDialog"] floating enable, resize set 60 ppt 70 ppt, move position center
for_window [window_type="dialog"] floating enable

# ── Keybindings (i3 only; the shared ones are in common.conf) ──
# Apps
bindsym $mod+x              exec i3-msg -q '[class="(?i)librewolf"] focus' || $browser
bindsym $mod+t              exec i3-msg -q '[class="^Alacritty$"] focus' || $term
# Vesktop: the same key as sway, sizes in ppt
bindsym $mod+Shift+d        exec $scripts/open.sh vesktop "60 ppt" "70 ppt" vesktop
bindsym $mod+Shift+w        exec $scripts/wallpaper.sh pick
bindsym $mod+Shift+o        exec $scripts/wallpaper.sh slideshow
# Area screenshot like $mod+Shift+s (common.conf), which Android takes for its own screenshot
bindsym $mod+Shift+a        exec $scripts/screenshot.sh
# Alt+Tab: window list (sway's swayr doesn't exist here)
bindsym Mod1+Tab            exec rofi -show window

# Session: back to Android, the desktop keeps running (closing/exiting: the power menu, $mod+Shift+p)
bindsym $mod+Shift+m        exec desktop hide

# ── Bar ─────────────────────────────────────────────
bar {
    position top
    workspace_min_width 30
    status_command i3status-rs ~/.config/wm/i3status-rs.toml
    font pango:JetBrainsMono Nerd Font 11
    # See-through background (xcompmgr draws the alpha)
    i3bar_command i3bar --transparency
    # No tray_output: "primary" showed no tray at all (Termux:X11's screen isn't marked primary)
    # Clear of the screen's rounded corners on the left (top, right, bottom, left). The right's gap is
    # tray-spacer's empty tray slot (autostart): padding there left the tray in the corner and, with
    # the slot, made that side's gap twice the left's
    padding 0 0 0 24px

    colors {
        background         #000000b3
        statusline         #ffffff
        separator          #333333
        focused_workspace  #ffffff #ffffff #000000
        # The bar's own tint: fully clear buttons cut a hole through it, and on a light wallpaper
        # they looked as bright as the focused one
        active_workspace   #000000b3 #000000b3 #ffffff
        inactive_workspace #000000b3 #000000b3 #777777
        urgent_workspace   #ffffff #555555 #ffffff
    }
}
