# i3 on the tablet (Termux:X11). The looks and window keys shared with sway are in
# ~/.config/wm/common.conf. ~/.config/i3/config is a symlink to this file; `desktop` (~/.config/termux/bin)
# starts it. i3 can't use variables set in common.conf here, so the bar's colours are spelled out.

# ── Variables ───────────────────────────────────────
# Super, like the desktop: needs Termux:X11's "capture system shortcuts" (else Android takes it;
# then use Mod1 = Alt)
set $mod        Mod4
set $term       alacritty
set $term_float alacritty --class scratch-float
set $fm         thunar
set $menu       rofi -show drun
set $browser    librewolf
set $scripts    ~/.config/wm/scripts

include ~/.config/wm/common.conf

# ── Autostart ───────────────────────────────────────
# Dark/light first: writes alacritty's colours and qt6ct's file, starts xsettingsd (GTK on X11)
exec --no-startup-id $scripts/darkmode.sh apply
exec --no-startup-id dunst
# Compositor: xcompmgr, transparency only (the see-through bar, rofi, dunst and alacritty; no blur).
# picom lagged (Termux:X11 has no direct GPU path to the screen: seconds per key press with blur)
# and with xrender windows disappeared and came back
exec --no-startup-id xcompmgr
exec --no-startup-id $scripts/clipstore.sh
exec --no-startup-id $scripts/wallpaper.sh restore

# ── Window rules (X11: by class) ────────────────────
# Sizes as a share of the screen: fixed pixels look tiny at the tablet's DPI
for_window [class="^clipboard$"] floating enable, resize set 50 ppt 50 ppt, move position center
# Scratchpad apps ($mod+Shift+Return / e, the power menu's terminal): floating in the scratchpad,
# shown. The same key (or $mod+minus) hides/shows them again
for_window [class="^(scratch-.*|Thunar)$"] floating enable, resize set 60 ppt 70 ppt, move scratchpad, scratchpad show, move position center
# Eclipse Music (Electron, ~/.config/nixos/eclipse): floating like on sway
for_window [class="(?i)^eclipse$"] floating enable, resize set 60 ppt 70 ppt, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

# ── Keybindings (i3 only; the shared ones are in common.conf) ──
# Apps
bindsym $mod+x              exec i3-msg -q '[class="(?i)librewolf"] focus' || $browser
bindsym $mod+t              exec i3-msg -q '[class="^Alacritty$"] focus' || $term
bindsym $mod+Shift+w        exec $scripts/wallpaper.sh pick
bindsym $mod+Shift+o        exec $scripts/wallpaper.sh slideshow
# Alt+Tab: window list (sway's swayr doesn't exist here)
bindsym Mod1+Tab            exec rofi -show window

# Session
# Hide or close the desktop, or exit Termux (the power menu's first three entries)
bindsym $mod+Shift+m        exec $scripts/power.sh leave

# ── Bar ─────────────────────────────────────────────
bar {
    position top
    workspace_min_width 30
    status_command i3status-rs ~/.config/wm/i3status-rs.toml
    font pango:JetBrainsMono Nerd Font 9
    # See-through background (xcompmgr draws the alpha)
    i3bar_command i3bar --transparency
    tray_output primary
    # Clear of the screen's rounded corners (top left and right)
    padding 0 48px

    colors {
        background         #000000b3
        statusline         #ffffff
        separator          #333333
        focused_workspace  #ffffff #ffffff #000000
        active_workspace   #00000000 #00000000 #ffffff
        inactive_workspace #00000000 #00000000 #777777
        urgent_workspace   #ffffff #555555 #ffffff
    }
}
