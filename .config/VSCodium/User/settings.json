{
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.folders.color": "#9e9e9e",
    "editor.fontFamily": "'Iosevka Nerd Font', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'Iosevka Nerd Font'",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "trailing",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "shellcheck.executablePath": "shellcheck",
    "workbench.startupEditor": "none",
    "window.menuBarVisibility": "toggle",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "update.showReleaseNotes": false,
    "extensions.autoCheckUpdates": true,
    "extensions.autoUpdate": "on",
    "chat.disableAIFeatures": true,
    "window.autoDetectColorScheme": true,
    "workbench.preferredDarkColorTheme": "Tsoding Gruber Darker",
    "workbench.preferredLightColorTheme": "Gruvbox Light Medium",
    // Lean comes from Nix, without elan: else it warns at every start
    "lean4.showSetupWarnings": false,
    "git.openRepositoryInParentFolders": "never"
}
